# Copy to .env and fill in for local development.

NODE_ENV=development
PORT=3000

# PostgreSQL connection. The API sets `app.tenant_id` (and, for a
# customer's own cross-tenant reads, `app.user_id`) per request for
# RLS; see src/database/database.service.ts.
#
# IMPORTANT: this must point at the `app_runtime` role created by
# db/migrations/003_app_runtime_role.sql, NOT at the role you ran
# migrations as. PostgreSQL row-level security never applies to a
# table's owner, so connecting as the migration/owner role makes every
# RLS policy in this project silently do nothing. Run migrations as an
# admin/owner role, set a password for app_runtime out of band
# (`ALTER ROLE app_runtime WITH PASSWORD '...'`), and put that role in
# this URL instead.
DATABASE_URL=postgres://app_runtime:CHANGE_ME@localhost:5432/marketplace_dev

# Access tokens are short-lived signed JWTs. Refresh tokens are opaque,
# stored hashed in user_session, and rotated on every use.
JWT_SECRET=replace-with-a-long-random-value
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Verification codes (email/phone) and password-reset codes. This
# milestone's sender is a mock: it writes the code to the server log
# instead of sending real SMS/email. Do not point this at a real
# provider until Q2 (payment/communication provider selection) is closed.
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_CODE_MAX_ATTEMPTS=5

# Account lockout after repeated failed sign-in attempts (BR-SEC-02).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Phase 6 hardening: comma-separated list of front-end origins allowed
# to call this API from a browser (e.g.
# https://app.example.com,https://provider.example.com). Empty in
# development — same-origin tools, curl and Postman aren't affected by
# CORS at all. Set this before deploying, or every browser request from
# a real front end will be blocked. See main.ts and configuration.ts.
CORS_ALLOWED_ORIGINS=

# Phase 4 (Payments): the shared secret the mock payment provider signs
# webhook request bodies with (HMAC-SHA256), and PaymentsController
# verifies incoming webhooks against. A real PSP integration replaces
# this with that provider's own signing scheme — see
# payment-provider.interface.ts and mock-payment.provider.ts.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-value
